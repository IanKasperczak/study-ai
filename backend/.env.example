PROJECT_NAME=Project Study IA
API_PREFIX=/api
CORS_ORIGINS=*
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
PROJECTS_DIR=./storage/projects

# Provider de IA. Valores posibles:
#   ""       -> auto: OPENAI_API_KEY/OPENAI_BASE_URL, si no NVIDIA_API_KEY, si no Ollama
#   "openai" -> OpenAI o cualquier API OpenAI-compatible (OPENAI_BASE_URL)
#   "nim"    -> NVIDIA NIM, hosteado (integrate.api.nvidia.com) o self-hosted
#   "ollama" -> modelo local servido por Ollama (http://localhost:11434)
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Tiempo maximo (segundos) de espera a la IA. Aumentalo si tu PC es lenta
# (modelos locales en CPU pueden tardar bastante).
AI_TIMEOUT_SECONDS=300

# Ollama (modelo local; cambialo por el que descargues, ej: llama3.2, qwen2.5, phi3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# NVIDIA NIM. Para el catalogo hosteado (https://build.nvidia.com) genera una
# API key y dejala en NVIDIA_API_KEY; para un NIM self-hosted (container propio)
# apunta NIM_BASE_URL a tu endpoint y deja NVIDIA_API_KEY vacio.
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-8b-instruct
# Modelo de embeddings NIM para el RAG semantico (busqueda por significado en
# vez de coincidencia de palabras). Se usa automaticamente si el provider
# activo es "nim" y hay chunks embebidos; si falla, el RAG cae a busqueda
# lexica sin romper nada.
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Equivalentes de embeddings para los otros providers (mismo mecanismo).
OPENAI_EMBED_MODEL=text-embedding-3-small
OLLAMA_EMBED_MODEL=nomic-embed-text